from snakemake.utils import min_version
min_version("8.0")

import gzip
import re
from pathlib import Path
from urllib.request import urlopen
from urllib.error import URLError

wildcard_constraints:
    chrom = r'[0-9XYMT]+',

dir_resources = str(Path(config.get("resource_dir", "resources")))
download_resources = dir_resources == "resources"

if download_resources:
    iconnect = False
    if not ('nointernet' in config and config['nointernet']):
        try:
            response = urlopen('https://www.google.com/', timeout=10)
            iconnect = True
        except URLError as ex:
            pass
    ftp = storage.ftp if iconnect else lambda x: x
    http = storage.http if iconnect else lambda x: x

    resourcedir = ('https://raw.githubusercontent.com/odelaneau/shapeit/' +
                   'f9d726472df3f26120fe738a137fc41cbcc0bbf4/resources/')
    
    checkpoint download_chunk_b38:
        input: ancient(http(resourcedir + 'chunks/b38/{size}/chunks_chr{chrom}.txt'))
        output: 'resources/shapeit/chunks/b38/{size}/chunks_chr{chrom}.txt'
        resources:
            mem_mb = 4000,
            time_min = 30
        shell: 'cp {input} {output}'
    
    rule download_map:
        input: ancient(http(resourcedir + 'maps/{build}/chr{chrom}.{build}.gmap.gz'))
        output: 'resources/shapeit/maps/chr{chrom}.{build}.gmap.gz'
        resources:
            mem_mb = 4000,
            time_min = 30
        shell: 'cp {input} {output}'

def input_anac(fname):
    # check if the file has AN and AC in the header
    if 'AC' in config:
        return config['AC']
    an = False
    ac = False
    with gzip.open(fname, 'rt') as f:
        for line in f:
            processed = line.strip()
            if re.search(r'^#CHROM', processed):
                return bool(an and ac)
            if not an:
              an = re.search(r'^##INFO=<ID=AN,.+', processed)
            if not ac:
              ac = re.search(r'^##INFO=<ID=AC,.+', processed)

rule shapeit_filter:
    input: '{genotypes}.chr{chrom}.vcf.gz'
    output: temp('temp/shapeit_filtered/{genotypes}.chr{chrom}.filtered.bcf')
    threads: 2
    resources:
        mem_mb = 8000,
        runtime = "48h"
    conda: 'envs/shapeit5.yaml'
    shell: '''
bcftools view -Ob -o {output} -i 'F_MISSING < 0.1 && (FILTER = "PASS" || FILTER = ".") && MAC > 0' {input}
'''

rule shapeit_ac:
    input: rules.shapeit_filter.output
    output: temp('temp/shapeit_filtered/{genotypes}.chr{chrom}.filtered.withac.bcf')
    threads: 2
    resources:
        mem_mb = 8000,
        runtime = "16h"
    conda: 'envs/shapeit5.yaml'
    shell: '''
bcftools +fill-tags {input} -Ob -o {output} -- -t AN,AC
'''

def annotate_or_not(wc):
    if input_anac(f'{wc.genotypes}.chr{wc.chrom}.vcf.gz'):
        return f'temp/shapeit_filtered/{wc.genotypes}.chr{wc.chrom}.filtered.bcf'
    else:
        return f'temp/shapeit_filtered/{wc.genotypes}.chr{wc.chrom}.filtered.withac.bcf'

rule shapeit_commonvar_chunked:
    input:
        geno = annotate_or_not, # '{genotypes}.chr{chrom}.withac.bcf', #TODO: replace
        index = lambda wc: annotate_or_not(wc) + '.csi', # {genotypes}.chr{chrom}.withac.bcf.csi', #TODO: replace
        map = dir_resources + '/shapeit/maps/chr{chrom}.b38.gmap.gz'
    params:
        region = lambda wc: re.sub("_", ":", wc.chunk)
    output: temp('temp/shapeit_commonvar_chunked/{genotypes}.chr{chrom}.chunk__{chunk}.phased_common.bcf')
    log: 'logs/{genotypes}.chr{chrom}.chunk__{chunk}.phased_common.log'
    threads: 42
    resources:
        mem_mb = 168000,
        runtime = "96h"
    conda: 'envs/shapeit5.yaml'
    shell: '''
SHAPEIT5_phase_common \
  --input {input.geno} \
  --region {params.region} \
  --map {input.map} \
  --output {output} \
  --log {log} \
  --thread {threads} \
  --filter-maf 0.001
'''

