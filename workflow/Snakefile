use rule shapeit_filter as shapeit_filter_simple with:
    input: '{genotypes}.vcf.gz'
    output: temp('temp/shapeit_filtered_simple/{genotypes}.filtered.bcf')

use rule shapeit_ac as shapeit_ac_simple with:
    input: rules.shapeit_filter_simple.output
    output: temp('temp/shapeit_filtered_simple/{genotypes}.filtered.withac.bcf')

def annotate_or_not_simple(wc):
    if input_anac(f'{wc.genotypes}.vcf.gz'):
        return f'temp/shapeit_filtered_simple/{wc.genotypes}.filtered.bcf'
    else:
        return f'temp/shapeit_filtered_simple/{wc.genotypes}.filtered.withac.bcf'

def choose_map_simple(wc):
    chrom = re.search(r'chr?([0-9XYMT]+)', wc.genotypes).group(1)
    return dir_resources + f'/shapeit/maps/chr{chrom}.b38.gmap.gz'

rule shapeit_commonvar_simple:
    input:
        geno = annotate_or_not_simple,
        index = lambda wc: annotate_or_not_simple(wc) + '.csi',
        map = choose_map_simple
    output: temp('temp/shapeit_commonvar_simple/{genotypes}.phased_common.bcf')
    log: 'logs/{genotypes}.phased_common.log'
    threads: 42
    resources:
        mem_mb = 168000,
        runtime = "96h"
    conda: 'envs/shapeit5.yaml'
    shell: '''
SHAPEIT5_phase_common \
  --input {input.geno} \
  --map {input.map} \
  --output {output} \
  --log {log} \
  --thread {threads} \
  --filter-maf 0.001
'''

